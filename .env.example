# Public site URL
NEXT_PUBLIC_SITE_URL=https://luxuryregistry.vercel.app

# Once the 625 hero images are in a public CDN/storage bucket,
# set this to the directory that directly contains LR-xxxx_*_hero.jpg files.
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=

# Shopify Storefront API — server-side only
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
