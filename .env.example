# Public site URL
NEXT_PUBLIC_SITE_URL=https://luxuryregistry.io

# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose this as NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public image directory containing LR-xxxx_*_hero.jpg files.
# A Supabase public bucket URL works here.
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=

# Stripe — server-side secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe test-mode keys for the hidden checkout test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
